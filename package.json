{
  "name": "rpm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TZ=UTC next dev",
    "dev:debug": "TZ=UTC RPM_DEV_BYPASS_AUTH=true next dev",
    "build": "next build --webpack",
    "vercel-build": "drizzle-kit migrate && next build --webpack",
    "start": "next start",
    "start:debug": "RPM_DEV_BYPASS_AUTH=true next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "npx drizzle-kit studio",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "deploy": "vercel --prod",
    "sentry:issues": "dotenv -e .env.local -- npx sentry-cli issues list",
    "sentry:releases": "dotenv -e .env.local -- npx sentry-cli releases list",
    "sentry:info": "dotenv -e .env.local -- npx sentry-cli info",
    "prepare": "husky || true"
